# Which CKB chain to use: testnet | mainnet | devnet
# This also controls which address format (ckb1... vs ckt1...) is generated,
# so it must always match the network you're actually broadcasting to.
#
# Docker --env-file does NOT strip quotes. Use bare values only:
#   CKB_NETWORK=mainnet
# NOT:
#   CKB_NETWORK="mainnet"
CKB_NETWORK=testnet

# RPC endpoints (only the one matching CKB_NETWORK is used)
CKB_TESTNET_URL=https://testnet.ckb.dev
CKB_MAINNET_URL=https://mainnet.ckb.dev/rpc
CKB_DEVNET_URL=http://127.0.0.1:8114

# Optional: comma-separated list of origins allowed to call this API from a
# browser, e.g. https://app.example.com,https://example.com
# If unset, CORS is permissive (any origin) -- fine for server-to-server or
# native-app callers, but set this before pointing a web frontend at the API.
CORS_ALLOWED_ORIGINS=

# Optional: enables the /dev/* endpoints (server-side mnemonic generation,
# server-side signing given a mnemonic). These exist only for quick local
# iteration when you don't have a client-side signer wired up yet.
# NEVER set this to true in production -- leave it unset/false so the
# server can never see or handle a private key.
ALLOW_DEV_KEY_ENDPOINTS=false

# Optional: Fiber Network Node (FNN) JSON-RPC URL for /fiber/* endpoints
# (invoices, send_payment, and CCH swaps CKB↔Lightning). Leave unset to
# keep existing on-chain wallet endpoints working without Fiber.
# Example local node: http://127.0.0.1:8227
# After .github/workflows/deploy-fiber.yml runs, the Droplet .env is set to:
#   FIBER_RPC_URL=http://172.17.0.1:8227
FIBER_RPC_URL=

# Optional: Bearer token if the Fiber RPC has Biscuit auth enabled.
# Sent as Authorization: Bearer <token>. Leave empty for local unauthenticated RPC.
FIBER_RPC_TOKEN=

# Used by Deploy Fiber Node GitHub Action (secret FIBER_SECRET_KEY_PASSWORD preferred).
FIBER_SECRET_KEY_PASSWORD=change-me-to-a-strong-password

